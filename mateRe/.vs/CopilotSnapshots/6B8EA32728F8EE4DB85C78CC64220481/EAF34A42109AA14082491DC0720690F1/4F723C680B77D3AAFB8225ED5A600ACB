using System;
using System.Windows.Forms;

namespace mate22
{
	internal static class Program
	{
		/// <summary>
		///  The main entry point for the application.
		/// </summary>
		[STAThread]
		static void Main()
		{
			// Inicialización de configuración de la aplicación (alta DPI, fuentes, etc.)
			ApplicationConfiguration.Initialize();

			// Registrar manejadores para excepciones no controladas y mostrar detalles si ocurre algo
			Application.SetUnhandledExceptionMode(UnhandledExceptionMode.CatchException);
			Application.ThreadException += (s, e) => ShowExceptionAndExit(e.Exception, "Error en hilo de interfaz");
			AppDomain.CurrentDomain.UnhandledException += (s, e) => {
				Exception ex = e.ExceptionObject as Exception ?? new Exception("Excepción no gestionada");
				ShowExceptionAndExit(ex, "Excepción no gestionada");
			};

			// Ejecutar directamente el formulario de registro para evitar problemas de EPPlus en inicio
			try
			{
				Application.Run(new registro());
			}
			catch (Exception ex)
			{
				ShowExceptionAndExit(ex, "Error al iniciar la aplicación");
			}
		}

		private static void ShowExceptionAndExit(Exception ex, string title)
		{
			try
			{
				MessageBox.Show(title + "\n\n" + ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error);
			}
			catch { }
			Environment.Exit(1);
		}
	}
}
