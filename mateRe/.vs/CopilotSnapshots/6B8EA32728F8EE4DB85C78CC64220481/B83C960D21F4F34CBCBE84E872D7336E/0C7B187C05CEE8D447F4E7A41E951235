		private void EnsureExcelFileExists(string path)
			{
				try
				{
					EPPlusHelper.EnsureFileExists(path, "Usuarios", new[] { "Usuario", "Contraseña", "Nivel", "Puntaje" });
				}
				catch (Exception ex)
				{
					System.Diagnostics.Debug.WriteLine($"Error al crear archivo Excel: {ex.Message}");
				}
			}

		private void btnRegistrar_Click(object sender, EventArgs e)
		{
			string usuario = txtRegUsuario.Text.Trim();
			string contra = txtRegContra.Text.Trim();

			if (string.IsNullOrEmpty(usuario) || string.IsNullOrEmpty(contra))
			{
				MessageBox.Show("Por favor, llena todos los campos.", "Error", MessageBoxButtons.OK, MessageBoxIcon.Warning);
				return;
			}

			FileInfo file = new FileInfo(rutaExcel);

			using (ExcelPackage package = new ExcelPackage(file))
			{
				ExcelWorksheet worksheet = package.Workbook.Worksheets.Count > 0 ? package.Workbook.Worksheets[0] : package.Workbook.Worksheets.Add("Usuarios");
				int totalFilas = worksheet.Dimension?.End.Row ?? 1;

				// Verificar si usuario existe
				for (int i = 2; i <= totalFilas; i++)
				{
					if (worksheet.Cells[i, 1].Value?.ToString() == usuario)
					{
						MessageBox.Show("El usuario ya existe. Intenta con otro.", "Error", MessageBoxButtons.OK, MessageBoxIcon.Error);
						return;
					}
				}

				int nuevaFila = totalFilas + 1;
				worksheet.Cells[nuevaFila, 1].Value = usuario;
				worksheet.Cells[nuevaFila, 2].Value = contra;
				worksheet.Cells[nuevaFila, 3].Value = 1; // Nivel inicial
				worksheet.Cells[nuevaFila, 4].Value = 0; // Puntaje inicial

				package.Save();
			}

			MessageBox.Show("¡Usuario registrado con éxito!", "Éxito", MessageBoxButtons.OK, MessageBoxIcon.Information);
			// Opcional: sincronizar con UserStore para disponibilidad centralizada
			try
			{
				var existing = UserStore.GetUser(usuario);
				if (existing == null)
				{
					var newUser = new UserData { Username = usuario, PasswordHash = UserStore.HashPassword(contra), NivelMaximo = 1, AciertosTotales = 0, ErroresTotales = 0, Score = 0 };
					UserStore.AddOrUpdateUser(newUser);
				}
			}
			catch { }
			txtRegUsuario.Clear(); txtRegContra.Clear();
				}

				private void btnLogin_Click(object sender, EventArgs e)
		{
			string usuario = txtLoginUsuario.Text.Trim();
			string contra = txtLoginContra.Text.Trim();

			if (string.IsNullOrEmpty(usuario) || string.IsNullOrEmpty(contra))
			{
				MessageBox.Show("Rellena usuario y contraseña.", "Error", MessageBoxButtons.OK, MessageBoxIcon.Warning);
				return;
			}

			FileInfo file = new FileInfo(rutaExcel);

			using (ExcelPackage package = new ExcelPackage(file))
			{
				ExcelWorksheet worksheet = package.Workbook.Worksheets.Count > 0 ? package.Workbook.Worksheets[0] : null;
				if (worksheet == null)
				{
					MessageBox.Show("Archivo de usuarios inválido.", "Error", MessageBoxButtons.OK, MessageBoxIcon.Error);
					return;
				}

				int totalFilas = worksheet.Dimension?.End.Row ?? 1;

				for (int i = 2; i <= totalFilas; i++)
				{
					string userExcel = worksheet.Cells[i, 1].Value?.ToString();
					string passExcel = worksheet.Cells[i, 2].Value?.ToString();

					if (userExcel == usuario && passExcel == contra)
									{
										int nivelGuardado = Convert.ToInt32(worksheet.Cells[i, 3].Value ?? 1);
										int puntajeGuardado = Convert.ToInt32(worksheet.Cells[i, 4].Value ?? 0);

										MessageBox.Show($"¡Bienvenido {usuario}! Nivel: {nivelGuardado}, Puntaje: {puntajeGuardado}", "Login Exitoso", MessageBoxButtons.OK, MessageBoxIcon.Information);

										// Abrir Form1 y pasar progreso
										var f = new Form1();
										f.CurrentUsername = usuario; // sincronizar nombre de usuario en Form1
										f.nivelMaximoDesbloqueado = nivelGuardado;
										f.CargarProgreso();
										this.Hide();
										f.ShowDialog();
										this.Close();
										return;
									}
				}
			}

			MessageBox.Show("Usuario o contraseña incorrectos.", "Error", MessageBoxButtons.OK, MessageBoxIcon.Error);
		}
