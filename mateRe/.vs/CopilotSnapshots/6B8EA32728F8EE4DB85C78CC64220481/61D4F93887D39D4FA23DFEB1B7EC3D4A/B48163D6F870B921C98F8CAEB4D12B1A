{
	public partial class Form1 : Form
	{
		public int nivelActual = 1;
		public int nivelMaximoDesbloqueado = 1;
		public int aciertos = 0;
		public string CurrentUsername = "";
		int respuestasCorrectas = 0;
		int respuestaCorrecta;
		Random rnd = new Random();
		int tiempoRestante = 5;
		int tiempoMaximo = 5;
		bool esperandoRespuesta = false;
		System.Windows.Forms.Timer timerAvanceAutomatico;
		System.Collections.Generic.Dictionary<int, int> nivelAciertos = new System.Collections.Generic.Dictionary<int, int>();
		System.Collections.Generic.Dictionary<int, int> nivelErrores = new System.Collections.Generic.Dictionary<int, int>();
		System.Collections.Generic.Dictionary<int, int> nivelScores = new System.Collections.Generic.Dictionary<int, int>();
		System.Collections.Generic.Dictionary<int, TimeSpan> nivelTiempos = new System.Collections.Generic.Dictionary<int, TimeSpan>();
