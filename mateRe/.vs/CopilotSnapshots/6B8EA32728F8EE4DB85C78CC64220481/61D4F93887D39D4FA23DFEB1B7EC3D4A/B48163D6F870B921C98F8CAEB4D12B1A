		// === CONSTRUCTOR ===
		public Form1()
		{
			InitializeComponent();
			CargarProgreso();
			ConfigurarEventos();
			ConfigurarBarraProgreso();
			ActualizarContador();
			GenerarEjercicio();
			btnContinuar.Click += BtnContinuar_Click;
			btnLogout.Click += BtnLogout_Click;
		}

		public void CargarProgreso()
		{
			nivelActual = nivelMaximoDesbloqueado;
			MostrarPanelNivel(nivelActual);
			ConfigurarBarraProgreso();
		}

		private void MostrarPanelNivel(int nivel)
			{
				panelNivel1.Visible = (nivel == 1);
				panelNivel2.Visible = (nivel == 2);
				panelNivel3.Visible = (nivel == 3);
				panelNivel4.Visible = (nivel == 4);
				lblNivel.Text = $"Nivel Actual: {nivel}";
				EnsurePanelImages();
			}

		private void ConfigurarEventos()
		{
			Button[] todosLosBotones = {
				btnCarta1, btnCarta2, btnCarta3,
				btnCarta1_2, btnCarta2_2, btnCarta3_2,
				btnCarta1_3, btnCarta2_3, btnCarta3_3,
				btnCarta1_4, btnCarta2_4, btnCarta3_4
			};

			foreach (Button btn in todosLosBotones)
			{
				btn.Click += new EventHandler(VerificarCarta_Click);
			}

			tabControlNiveles.Selecting += TabControlNiveles_Selecting;
		}

		private void TabControlNiveles_Selecting(object sender, TabControlCancelEventArgs e)
		{
			if (e.TabPageIndex > nivelMaximoDesbloqueado - 1)
			{
				e.Cancel = true;
				MessageBox.Show("¡Aún no has desbloqueado este nivel! Completa el nivel anterior primero.", "Nivel Bloqueado");
			}
			else
			{
				nivelActual = e.TabPageIndex + 1;
				respuestasCorrectas = 0;
				aciertos = 0;
				timerOperacion.Stop();
				ConfigurarBarraProgreso();
				GenerarEjercicio();
			}
		}

		private void ConfigurarBarraProgreso()
			{
				lblNivel.Text = $"Nivel Actual: {nivelActual}";
				ActualizarContador();
			}

		private int ObtenerTiempoMaximoPorNivel()
		{
			return nivelActual switch
			{
				1 => 15,
				2 => 30,
				3 => 40,
				4 => 45,
				_ => 15
			};
		}

		// === CENTRO: GENERAR OPERACIÓN MATEMÁTICA ===
			private void GenerarEjercicio()
			{
				if (!nivelTiempos.ContainsKey(nivelActual) || nivelAciertos.ContainsKey(nivelActual) == false)
				{
					nivelAciertos[nivelActual] = 0;
					nivelErrores[nivelActual] = 0;
					nivelScores[nivelActual] = 100;
					nivelTiempos[nivelActual] = TimeSpan.Zero;
					nivelInicio = DateTime.Now;
				}

			switch (nivelActual)
			{
				case 1:
					GenerarEjercicioNivel1();
					break;
				case 2:
					GenerarEjercicioNivel2();
					break;
				case 3:
					GenerarEjercicioNivel3();
					break;
				case 4:
					GenerarEjercicioNivel4();
					break;
				default:
					GenerarEjercicioNivel1();
					break;
			}
		}

		// === Nivel 1: SUMAS ===
			private void GenerarEjercicioNivel1()
			{
				int a = rnd.Next(10, 100);
				int b = rnd.Next(10, 100);
				respuestaCorrecta = a + b;
				lblOperacion.Text = $"{a} + {b} = ?";
				GenerarOpcionesCartas();
				IniciarTemporizador();
			}

		// === Nivel 2: MULTIPLICACIONES ===
			private void GenerarEjercicioNivel2()
			{
				int a = rnd.Next(2, 11);
				int b = rnd.Next(2, 11);
				respuestaCorrecta = a * b;
				lblOperacion.Text = $"{a} x {b} = ?";
				GenerarOpcionesCartas();
				IniciarTemporizador();
			}

		// === Nivel 3: DIVISIONES ===
			private void GenerarEjercicioNivel3()
			{
				int b = rnd.Next(2, 10);
				int resultadoTemporal = rnd.Next(1, 10);
				int a = b * resultadoTemporal;
				respuestaCorrecta = resultadoTemporal;
				lblOperacion.Text = $"{a} ÷ {b} = ?";
				GenerarOpcionesCartas();
				IniciarTemporizador();
			}

		// === Nivel 4: MIXTO (Sumas, Multiplicaciones, Divisiones) ===
			private void GenerarEjercicioNivel4()
			{
				int tipo = rnd.Next(0, 3);
			int a = 0, b = 0;
			if (tipo == 0)
			{
				a = rnd.Next(50, 201); // sumas mayores
				b = rnd.Next(50, 201);
				respuestaCorrecta = a + b;
				lblOperacion.Text = $"{a} + {b} = ?";
			}
			else if (tipo == 1)
			{
				a = rnd.Next(10, 51);
				b = rnd.Next(5, 21);
				respuestaCorrecta = a * b;
				lblOperacion.Text = $"{a} x {b} = ?";
			}
			else
			{
				b = rnd.Next(2, 16);
				int resultadoTemporal = rnd.Next(2, 16);
				a = b * resultadoTemporal;
				respuestaCorrecta = resultadoTemporal;
				lblOperacion.Text = $"{a} ÷ {b} = ?";
			}
			GenerarOpcionesCartas();
			IniciarTemporizador();
		}

		private void IniciarTemporizador()
		{
			tiempoMaximo = ObtenerTiempoMaximoPorNivel();
			tiempoRestante = tiempoMaximo;
			esperandoRespuesta = true;
			lblTiempo.Text = $"Tiempo: {tiempoRestante}s";
			lblTiempo.ForeColor = Color.Green;
			timerOperacion.Start();
		}

		private void TimerOperacion_Tick(object sender, EventArgs e)
		{
			tiempoRestante--;
			lblTiempo.Text = $"Tiempo: {tiempoRestante}s";

			if (tiempoRestante <= 3)
				lblTiempo.ForeColor = Color.Red;
			else if (tiempoRestante <= 7)
				lblTiempo.ForeColor = Color.Orange;

			if (tiempoRestante <= 0)
				{
					timerOperacion.Stop();
					esperandoRespuesta = false;
					lblOperacion.Text = $"Error. Correcta: {respuestaCorrecta}";
					lblOperacion.ForeColor = Color.Red;
					timerAvanceAutomatico = new System.Windows.Forms.Timer();
					timerAvanceAutomatico.Interval = 1200;
					timerAvanceAutomatico.Tick += (s, args) =>
					{
						timerAvanceAutomatico.Stop();
						timerAvanceAutomatico.Dispose();
						lblOperacion.ForeColor = Color.Black;
						GenerarEjercicio();
					};
					timerAvanceAutomatico.Start();
				}
		}

		private void ReiniciarNivel()
			{
				aciertos = 0;
				respuestasCorrectas = 0;
				ActualizarContador();
				GenerarEjercicio();
			}

		private void GenerarOpcionesCartas()
		{
			int[] opciones = new int[3];
			opciones[0] = respuestaCorrecta;

			int error1, error2;

			do
			{
				error1 = respuestaCorrecta + rnd.Next(-5, 6);
			} while (error1 == respuestaCorrecta || error1 < 0);

			do
			{
				error2 = respuestaCorrecta + rnd.Next(-5, 6);
			} while (error2 == respuestaCorrecta || error2 == error1 || error2 < 0);

			opciones[1] = error1;
			opciones[2] = error2;

			opciones = opciones.OrderBy(x => rnd.Next()).ToArray();

						Button[] botonesActuales = ObtenerBotonesPorNivel(nivelActual);
						if (botonesActuales != null)
						{
							botonesActuales[0].Text = opciones[0].ToString();
							botonesActuales[1].Text = opciones[1].ToString();
							botonesActuales[2].Text = opciones[2].ToString();
								ActualizarContador();
							}
		}

		private Button[] ObtenerBotonesPorNivel(int nivel)
		{
			return nivel switch
			{
				1 => new Button[] { btnCarta1, btnCarta2, btnCarta3 },
				2 => new Button[] { btnCarta1_2, btnCarta2_2, btnCarta3_2 },
				3 => new Button[] { btnCarta1_3, btnCarta2_3, btnCarta3_3 },
				4 => new Button[] { btnCarta1_4, btnCarta2_4, btnCarta3_4 },
				_ => null
			};
		}

		// === CENTRO: VERIFICAR RESPUESTA DEL USUARIO ===
			private void VerificarCarta_Click(object sender, EventArgs e)
			{
				if (!esperandoRespuesta)
				{
					MessageBox.Show("El tiempo ha expirado. Debes reiniciar el nivel.", "Operación expirada");
					return;
				}

				Button cartaPresionada = sender as Button;
				if (cartaPresionada != null && int.TryParse(cartaPresionada.Text, out int respuestaElegida))
				{
					timerOperacion.Stop();
					esperandoRespuesta = false;

					if (respuestaElegida == respuestaCorrecta)
					{
						respuestasCorrectas++;
						if (respuestasCorrectas > 10) respuestasCorrectas = 10;
					ActualizarProgreso();
					// Mostrar el mensaje
					lblOperacion.Text = "¡Correcto!";
					lblOperacion.ForeColor = Color.Green;

					// Actualizar estadísticas por nivel
					if (!nivelAciertos.ContainsKey(nivelActual)) nivelAciertos[nivelActual] = 0;
					nivelAciertos[nivelActual] = Math.Min(10, nivelAciertos[nivelActual] + 1);

					// Avanzar automáticamente sin pausa bloqueante
					timerAvanceAutomatico = new System.Windows.Forms.Timer();
						timerAvanceAutomatico.Interval = 1000;
						timerAvanceAutomatico.Tick += (s, args) =>
						{
							timerAvanceAutomatico.Stop();
							timerAvanceAutomatico.Dispose();
							lblOperacion.ForeColor = Color.Black;
							nivelTiempos[nivelActual] += DateTime.Now - nivelInicio;
							if (respuestasCorrectas < 10) { GenerarEjercicio(); }
							else { FinalizarNivel(); }
						};
						timerAvanceAutomatico.Start();
					}
					else
					{
						lblOperacion.Text = $"Error. Correcta: {respuestaCorrecta}";
						lblOperacion.ForeColor = Color.Red;
						if (!nivelErrores.ContainsKey(nivelActual)) nivelErrores[nivelActual] = 0;
						nivelErrores[nivelActual]++;
						nivelScores[nivelActual] = Math.Max(0, nivelScores[nivelActual] - 10);
						nivelScores[nivelActual] = Math.Clamp(nivelScores[nivelActual], 0, 100);

					// Avanzar automáticamente sin pausa bloqueante
					timerAvanceAutomatico = new System.Windows.Forms.Timer();
					timerAvanceAutomatico.Interval = 1200; // 1.2 segundos
					timerAvanceAutomatico.Tick += (s, args) =>
					{
						timerAvanceAutomatico.Stop();
						timerAvanceAutomatico.Dispose();
						lblOperacion.ForeColor = Color.Black;
						GenerarEjercicio();
					};
					timerAvanceAutomatico.Start();
				}
			}
		}

		// === FINALIZAR NIVEL: GUARDAR PROGRESO ===
			private void FinalizarNivel()
			{
				timerOperacion.Stop();
				MessageBox.Show($"¡Felicidades! Completaste el Nivel {nivelActual}.");
				btnContinuar.Visible = true;

				if (nivelActual == nivelMaximoDesbloqueado && nivelMaximoDesbloqueado < 4)
				{
					nivelMaximoDesbloqueado++;
				}

				aciertos = respuestasCorrectas;
				ActualizarContador();

				int errores = Math.Clamp(10 - aciertos, 0, 10);
				int clampedAciertos = Math.Clamp(aciertos, 0, 10);
				double score = Math.Clamp(clampedAciertos * 10.0, 0.0, 100.0);

				try { GuardarRegistroAutomatico(nivelActual, aciertos, errores, score, nivelTiempos.ContainsKey(nivelActual) ? nivelTiempos[nivelActual] : TimeSpan.Zero); }
				catch { }

				try
				{
					string docPath = Environment.GetFolderPath(Environment.SpecialFolder.MyDocuments);
					string file = Path.Combine(docPath, "mate22_progreso.csv");
					string usuario = string.IsNullOrEmpty(CurrentUsername) ? "Anónimo" : CurrentUsername;
					string line = $"{usuario},{DateTime.Now},{nivelActual},{aciertos},{errores},{score}";
					File.AppendAllText(file, line + Environment.NewLine);
				}
				catch { }

				if (!string.IsNullOrEmpty(CurrentUsername))
				{
					var existing = UserStore.GetUser(CurrentUsername);
					if (existing == null)
					{
						var newUser = new UserData
						{
							Username = CurrentUsername,
							PasswordHash = UserStore.HashPassword(""),
							NivelMaximo = nivelMaximoDesbloqueado,
							AciertosTotales = aciertos,
							ErroresTotales = errores,
						Score = score
					};
					UserStore.AddOrUpdateUser(newUser);
				}
						else { UserStore.SaveUserProgress(CurrentUsername, nivelMaximoDesbloqueado, aciertos, errores, score); }
				}

				if (nivelActual == 4)
				{
					try
					{
						string docPath = Environment.GetFolderPath(Environment.SpecialFolder.MyDocuments);
						string reportFile = Path.Combine(docPath, $"mate22_reporte_{CurrentUsername}_{DateTime.Now:yyyyMMddHHmmss}.txt");
						TimeSpan totalTime = nivelTiempos.Values.Aggregate(TimeSpan.Zero, (acc, ts) => acc + ts);
						using (var sw = new StreamWriter(reportFile))
						{
							sw.WriteLine($"Reporte de {CurrentUsername} - {DateTime.Now}");
							sw.WriteLine("Resumen por nivel:");
							for (int i = 1; i <= 4; i++)
							{
								int a = nivelAciertos.ContainsKey(i) ? nivelAciertos[i] : 0;
								int e = nivelErrores.ContainsKey(i) ? nivelErrores[i] : 0;
								int s = nivelScores.ContainsKey(i) ? nivelScores[i] : (a == 10 ? 100 : Math.Max(0, 100 - e * 10));
								TimeSpan t = nivelTiempos.ContainsKey(i) ? nivelTiempos[i] : TimeSpan.Zero;
								sw.WriteLine($"Nivel {i}: Aciertos={a}, Errores={e}, Score={s}, Tiempo={t}");
							}
						sw.WriteLine($"Tiempo total: {totalTime}");
					}
					// Guardar en historial JSON usando GestorResultados con manejo de excepciones mejorado
					try
					{
						var usuario = string.IsNullOrEmpty(CurrentUsername) ? "Anónimo" : CurrentUsername;
						var nuevo = new Resultado
						{
							Nombre = usuario,
							Fecha = DateTime.Now.ToString("dd/MM/yyyy HH:mm"),
							ScoreNivel1 = nivelScores.ContainsKey(1) ? nivelScores[1] : 0,
							ScoreNivel2 = nivelScores.ContainsKey(2) ? nivelScores[2] : 0,
							ScoreNivel3 = nivelScores.ContainsKey(3) ? nivelScores[3] : 0,
							ScoreNivel4 = nivelScores.ContainsKey(4) ? nivelScores[4] : 0,
							TiempoTotal = totalTime.ToString(@"hh\:mm\:ss")
						};
						using (IResultadoGestor gestor = new GestorResultados()) { gestor.Guardar(nuevo); }
					}
					catch (ResultadoException ex) { MessageBox.Show($"Error al guardar resultado: {ex.Message}", "Error", MessageBoxButtons.OK, MessageBoxIcon.Error); }
					catch (Exception ex) { MessageBox.Show($"Error inesperado: {ex.Message}", "Error", MessageBoxButtons.OK, MessageBoxIcon.Error); }
					string reportText = File.ReadAllText(reportFile);
					var frm = new Form() { Text = "Reporte final", Width = 700, Height = 500, StartPosition = FormStartPosition.CenterParent };
					var txt = new TextBox() { Multiline = true, ReadOnly = true, Dock = DockStyle.Fill, ScrollBars = ScrollBars.Both, Text = reportText }; 
					frm.Controls.Add(txt);
					frm.ShowDialog();
				}
				catch { }
			}
		}

		private void ActualizarProgreso()
			aciertos = respuestasCorrectas;
			ActualizarContador();
		}

		private void ActualizarContador()
		{
			lblContador.Text = $"{aciertos}/10";
		}

		// === BOTÓN CONTINUAR AL SIGUIENTE NIVEL ===
		private void BtnContinuar_Click(object sender, EventArgs e)
		{
			btnContinuar.Visible = false;
			if (nivelActual < nivelMaximoDesbloqueado)
			{
				nivelActual++;
				respuestasCorrectas = 0;
				aciertos = 0;
				ConfigurarBarraProgreso();
				MostrarPanelNivel(nivelActual);
				GenerarEjercicio();
			}
		}

		// === BOTÓN CERRAR SESIÓN ===
		private void BtnLogout_Click(object sender, EventArgs e)
		{
			int errores = 10 - aciertos;
			double score = aciertos * 10.0;
			if (!string.IsNullOrEmpty(CurrentUsername))
			{
				try { UserStore.SaveUserProgress(CurrentUsername, nivelMaximoDesbloqueado, aciertos, errores, score); } catch { }
			}
			this.Hide();
			try { Application.OpenForms[0].Hide(); } catch { }
			try { var login = new FormLoginExcel(); login.ShowDialog(); } catch { var reg = new registro(); reg.ShowDialog(); }
			this.Close();
		}

