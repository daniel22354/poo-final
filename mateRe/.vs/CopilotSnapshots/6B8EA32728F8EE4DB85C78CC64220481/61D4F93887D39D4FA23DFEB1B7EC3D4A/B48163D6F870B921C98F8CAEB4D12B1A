		private void GuardarRegistroAutomatico(int nivel, int aciertos, int errores, double score, TimeSpan tiempo)
		{
			try
			{
				string rutaDocumentos = Environment.GetFolderPath(Environment.SpecialFolder.MyDocuments);
				string carpeta = Path.Combine(rutaDocumentos, "mate22");
				if (!Directory.Exists(carpeta)) Directory.CreateDirectory(carpeta);
				string rutaArchivo = Path.Combine(carpeta, "Registro_Mate22.xlsx");
				ExcelPackage.LicenseContext = LicenseContext.NonCommercial;
				FileInfo archivoExcel = new FileInfo(rutaArchivo);

				using (var excel = new ExcelPackage(archivoExcel))
				{
					var hoja = excel.Workbook.Worksheets["Resultados"] ?? excel.Workbook.Worksheets.Add("Resultados");
					// Crear encabezados si falta la primera fila
					if (hoja.Dimension == null || hoja.Cells[1,1].Value == null)
					{
						hoja.Cells[1, 1].Value = "Fecha/Hora";
						hoja.Cells[1, 2].Value = "Nivel";
						hoja.Cells[1, 3].Value = "Aciertos";
						hoja.Cells[1, 4].Value = "Errores";
						hoja.Cells[1, 5].Value = "Score";
						hoja.Cells[1, 6].Value = "Tiempo de Nivel";
						hoja.Row(1).Style.Font.Bold = true;
					}

					int filaVacia = hoja.Dimension == null ? 2 : hoja.Dimension.End.Row + 1;

					hoja.Cells[filaVacia, 1].Value = DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss");
					hoja.Cells[filaVacia, 2].Value = nivel;
					hoja.Cells[filaVacia, 3].Value = aciertos;
					hoja.Cells[filaVacia, 4].Value = errores;
					hoja.Cells[filaVacia, 5].Value = score;
					hoja.Cells[filaVacia, 6].Value = tiempo.ToString(@"hh\:mm\:ss");

					// Ajustar columnas
					hoja.Cells[hoja.Dimension.Address].AutoFitColumns();
					excel.Save();
				}
			}
			catch { }
		}

