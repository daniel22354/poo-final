		private void btnHistorial_Click(object sender, EventArgs e)
		{
			// Permitir solo al usuario "admin" (modificar según tu nombre de usuario)
			string allowedUser = "admin";
			string current = textUser.Text?.Trim() ?? string.Empty;
			if (!string.Equals(current, allowedUser, StringComparison.OrdinalIgnoreCase))
			{
				MessageBox.Show("Acceso denegado. Solo el usuario autorizado puede ver el historial.");
				return;
			}

			FormHistorial historial = new FormHistorial();
			historial.ShowDialog();
		}






